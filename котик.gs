costumes "assets/котик.svg";

# Правила, счёт и конец игры: победа или поражение.

set_x 172;
set_y 118;
set_size 55;

onflag {
    show монеты;
    show жизни;
    show волна;

    say "Башня стоит " & цена_башни & " монет, лучник — " & цена_лучника & ". Кликай по пустым местам!";
    wait 6;
    say "";
}

# Конец игры. Ждём, что случится раньше: кончатся жизни
# или дойдём до волны победы и добьём последних орков.
# Если жизнь кончилась, поздравлять уже нельзя — сначала проверяем её.
onflag {
    wait 1;
    until (жизни <= 0 or (волна >= волна_победы and 1 in орк_жив == 0)) {
        wait 0.3;
    }
    if жизни <= 0 {
        say "Орки прорвались! Игра окончена.";
    } else {
        say "Поздравляю, вы выиграли!";
    }
    wait 4;
    stop_all;
}