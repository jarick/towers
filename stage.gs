%include lib/константы

costumes "assets/фон.svg";

# Монеты, жизни и номер волны.
var монеты = 12;
var жизни = 3;
var волна = 1;

# Сколько орков уже выпущено.
var выпущено = 0;

# Орки живут в общих списках: по одной строчке на каждого.
#   орк_жив  — 1, если орк сейчас на поле, иначе 0
#   орк_путь — где он стоит по дороге
#   орк_сила — сколько ударов он ещё выдержит
list орк_жив = [];
list орк_путь = [];
list орк_сила = [];

# Заявки на выстрел: башня кладёт, стрела забирает и летит.
list заявка_цель = [];
list заявка_откуда_x = [];
list заявка_откуда_y = [];

# Счёт показываем на экране сразу, как только нажали флаг.
onflag {
    show монеты;
    show жизни;
    show волна;
}
