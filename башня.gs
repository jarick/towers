%include lib/константы

costumes "assets/пусто.svg", "assets/башня_0.svg", "assets/башня_1.svg", "assets/башня_2.svg", "assets/башня_3.svg";

sounds "assets/выстрел.wav";

# Три места под башни. Клик по пустому месту ставит башню.
# Клик по башне покупает лучника. Больше трёх лучников на башню не влезает.
# Каждый лучник раз в секунду просит стрелу, а стрела сама летит
# в того орка, который ушёл дальше всех.

set_y -10;
hide;

onflag {
    построена = 0;
    лучников = 0;
    моё_место = 0;
    repeat 3 {
        моё_место += 1;
        set_x -150 + (моё_место - 1) * 150;
        clone;
    }
}

onclone {
    show;
    forever {
        if построена > 0 and лучников > 0 {
            wait 1 / лучников;

            цель = 0;
            лучший = -999;
            номер = 1;
            repeat мест_для_орков {
                if орк_жив[номер] == 1 and орк_путь[номер] > лучший {
                    лучший = орк_путь[номер];
                    цель = номер;
                }
                номер += 1;
            }

            if цель > 0 {
                add цель to заявка_цель;
                add x_position() to заявка_откуда_x;
                add 24 to заявка_откуда_y;
                start_sound "выстрел";
            }
        } else {
            wait 0.2;
        }
    }
}

onclick {
    if построена == 0 {
        if монеты >= цена_башни {
            монеты -= цена_башни;
            построена = 1;
            switch_costume "башня_0";
        }
    }
    elif лучников < 3 and монеты >= цена_лучника {
        монеты -= цена_лучника;
        лучников += 1;
        switch_costume "башня_" & лучников;
    }
}