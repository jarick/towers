# Постоянные числа игры. Это не переменные, а макросы: компилятор
# подставляет числа прямо в блоки, поэтому в проекте не появляется
# лишних переменных и счётчиков в палитре.
#
# Заголовок подключается в каждый спрайт, которому нужны эти числа:
#   %include lib/константы

# Цены: башня и лучник.
%define цена_башни 5
%define цена_лучника 3

# Сколько орков помещается на поле сразу.
%define мест_для_орков 10

# На какой волне игрок побеждает. На этой волне орков уже не выпускают.
%define волна_победы 10

# Через сколько секунд после выпуска появляется следующий орк.
%define орк_появление_сек 2

# Сколько точек за кадр орк проходит по дороге.
%define орк_скорость 1.5
