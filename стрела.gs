costumes "assets/стрела.svg";

sounds "assets/попадание.wav";

# Стрелы. Башня кладёт заявку в списки, а стрела берёт её,
# летит к орку и отнимает у него одну силу.
# Направление полёта считаем сами: atan(вбок / вниз).

hide;
set_size 90;
set_volume 50;

onflag {
    delete заявка_цель;
    delete заявка_откуда_x;
    delete заявка_откуда_y;

    forever {
        if length заявка_цель > 0 {
            цель = заявка_цель[1];
            начало_x = заявка_откуда_x[1];
            начало_y = заявка_откуда_y[1];
            delete заявка_цель[1];
            delete заявка_откуда_x[1];
            delete заявка_откуда_y[1];

            # целимся туда, где орк окажется через время полёта
            шаг_x = (орк_путь[цель] + 16 - начало_x) / 10;
            шаг_y = (-130 - начало_y) / 10;

            угол = atan(шаг_x / шаг_y);
            if шаг_x > 0 {
                направление = угол + 180;
            } else {
                направление = угол - 180;
            }

            clone;
        }
        wait 0.03;
    }
}

onclone {
    set_x начало_x;
    set_y начало_y;
    point_in_direction направление;
    show;

    repeat 10 {
        change_x шаг_x;
        change_y шаг_y;
    }

    if орк_жив[цель] == 1 {
        орк_сила[цель] = орк_сила[цель] - 1;
        start_sound "попадание";
    }
    delete_this_clone;
}