%include lib/константы

costumes "assets/орк.svg";

# Орки идут по дороге слева направо, волна за волной.
# Каждый орк — отдельный клон: выпускающий даёт ему номер,
# клон идёт по дороге и в конце сам убирает себя с поля.

set_y -130;
set_size 90;
hide;

onflag {
    # поле и счёт начинаем заново
    монеты = 12;
    жизни = 3;
    волна = 1;
    выпущено = 0;

    delete орк_жив;
    delete орк_путь;
    delete орк_сила;
    repeat мест_для_орков {
        add 0 to орк_жив;
        add 0 to орк_путь;
        add 0 to орк_сила;
    }

    # выпускать орков волнами, пока не дойдём до волны победы.
    # Дошли — выпускать больше некого, игрок победил.
    until (волна >= волна_победы) {
        wait орк_появление_сек;
        свободное = 0;
        номер = 1;
        repeat мест_для_орков {
            if свободное == 0 and орк_жив[номер] == 0 {
                свободное = номер;
            }
            номер += 1;
        }
        if свободное > 0 {
            мой_номер = свободное;
            орк_путь[свободное] = -250;
            орк_сила[свободное] = волна;
            орк_жив[свободное] = 1;
            clone;
            выпущено += 1;
            if выпущено >= волна * 8 {
                волна += 1;
            }
        }
    }
}

onclone {
    set_x -250;
    show;

    # идём, пока не убили и не дошли до края
    until (орк_сила[мой_номер] <= 0 or x_position() > 240) {
        change_x орк_скорость;
        орк_путь[мой_номер] = x_position();
    }

    # убираем с поля и считаем, что случилось
    орк_жив[мой_номер] = 0;
    if орк_сила[мой_номер] <= 0 {
        монеты += 0.5;
    } else {
        жизни += -1;
    }
    delete_this_clone;
}